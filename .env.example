# Sri Vijaya EV Bike Services - Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials

# Next.js Public Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Used exclusively on the server for admin role checks & seed tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME="Sri Vijaya EV Bike Services"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_WHATSAPP=+919876543210
NEXT_PUBLIC_BUSINESS_PHONE=+919876543210

# Optional: Payment Gateway Keys (if configuring Razorpay online payments)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
